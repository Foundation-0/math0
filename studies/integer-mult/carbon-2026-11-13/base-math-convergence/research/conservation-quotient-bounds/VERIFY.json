{
  "schema": "integer-mult-verify/v1",
  "status": "ready",
  "commands": [
    "{python} -W error -B {package}/verify.py --check",
    "{python} -W error -B -m unittest discover -s {package}/tests -p 'test_*.py' -v"
  ],
  "inputs": [
    "research/conservation-quotient-bounds/certificates/conservation_quotient_certificate.json",
    "research/conservation-quotient-bounds/c11_base_verifier.c",
    "research/conservation-quotient-bounds/formal/BaseMathConvergence.lean",
    "research/conservation-quotient-bounds/check_certificate.py"
  ],
  "dependencies": {
    "python": ">=3.11 (stdlib only; PYTHONOPTIMIZE / -O forbidden)",
    "c_compiler": "gcc or clang supporting C11 __int128",
    "lean4_kernel": "optional downstream (`formal/BaseMathConvergence.lean` scanned fail-closed)"
  },
  "timeout_seconds": 60
}
