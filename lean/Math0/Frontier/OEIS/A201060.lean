import Math0.Statements.OEIS.A201060
import Math0.Audit

/-!
# Repdigits with repdigit digital product are repunits from `a(16) = 1111` on (A201060)

We prove Krizek's conjecture: `a(n)` is a repunit for every `n ≥ 16`.

A term `m ≥ 1111` is a repdigit `ddd…d` with `k ≥ 4` digits and digital product `d ^ k`. If
`d = 1`, `m` is a repunit. Otherwise `2 ≤ d ≤ 9` and we show that `d ^ k` is never a repdigit.
Write a nonzero repdigit as `N = e · R_j` with `1 ≤ e ≤ 9` and the repunit `R_j` (odd).

* `d` even: `16 ∣ d ^ k`, but `16 ∣ e · R_j` with `R_j` odd forces `16 ∣ e`, impossible.
* `d` odd: `d ^ k ≥ 81`, so `N` has at least two digits and `N mod 100 = 11 e`, a multiple
  of `11`. But the powers of `3`, `7`, `9` modulo `100` lie in the subgroup generated by `3`
  (20 residues), and the powers of `5` modulo `100` lie in `{1, 5, 25}`; none of these residues
  is divisible by `11`.

Finally `a(n) ≥ a(16) = 1111` for `n ≥ 16` (monotonicity of `Nat.nth` and the kernel-checked
data `a_data`), and `a(n)` is a term since the set of terms is infinite.
-/

namespace Math0.Frontier.A201060
open Math0.Statements.A201060

/-- One more digit: `rep e (j + 1) = e + 10 · rep e j`. -/
private lemma rep_succ (e j : ℕ) : rep e (j + 1) = e + 10 * rep e j := by
  simp [rep, List.replicate_succ, Nat.ofDigits_cons]

/-- A repdigit is its digit times a repunit. -/
private lemma rep_eq_mul (e j : ℕ) : rep e j = e * rep 1 j := by
  induction j with
  | zero => simp [rep]
  | succ j ih => rw [rep_succ, rep_succ, ih]; ring

/-- A nonempty repunit is odd. -/
private lemma odd_rep_one (j : ℕ) : Odd (rep 1 (j + 1)) := by
  rw [rep_succ]
  exact ⟨5 * rep 1 j, by ring⟩

/-- A positive repdigit is `rep (e + 1) (j + 1)` with `e < 9`. -/
private lemma repdigit_eq {N : ℕ} (h : IsRepdigit N) (hN : 0 < N) :
    ∃ j e, e < 9 ∧ rep (e + 1) (j + 1) = N := by
  have hmem := (isRepdigit_iff_mem_repList (L := N) (Nat.lt_pow_self (by norm_num))).1 h
  rcases mem_repList.1 hmem with h0 | ⟨j, -, e, he, hrep⟩
  · omega
  · exact ⟨j, e, he, hrep⟩

/-- A positive repdigit is not divisible by `16`. -/
private lemma repdigit_not_dvd_sixteen {N : ℕ} (h : IsRepdigit N) (hN : 0 < N) : ¬ 16 ∣ N := by
  obtain ⟨j, e, he, rfl⟩ := repdigit_eq h hN
  intro hdvd
  rw [rep_eq_mul] at hdvd
  have hcop : Nat.Coprime 16 (rep 1 (j + 1)) := by
    have h2 : Nat.Coprime 2 (rep 1 (j + 1)) := Nat.coprime_two_left.2 (odd_rep_one j)
    simpa using Nat.Coprime.pow_left 4 h2
  have := Nat.le_of_dvd (by omega) (hcop.dvd_of_dvd_mul_right hdvd)
  omega

/-- A repdigit `N ≥ 10` has `N mod 100 = 11 e`, a multiple of `11`. -/
private lemma repdigit_mod_hundred {N : ℕ} (h : IsRepdigit N) (hN : 10 ≤ N) :
    N % 100 % 11 = 0 := by
  obtain ⟨j, e, he, rfl⟩ := repdigit_eq h (by omega)
  rcases j with _ | j
  · simp [rep] at hN
    omega
  · rw [rep_succ, rep_succ]
    have h100 : (e + 1 + 10 * (e + 1 + 10 * rep (e + 1) j)) % 100 = 11 * (e + 1) := by omega
    rw [h100, Nat.mul_mod_right]

/-- If `1 ∈ T` and `T` is closed under multiplication by `D` modulo `100`, then all powers of
`D` lie in `T` modulo `100`. -/
private lemma pow_mod_mem (D : ℕ) (T : List ℕ) (h1 : 1 ∈ T) (hT : ∀ t ∈ T, t * D % 100 ∈ T)
    (K : ℕ) : D ^ K % 100 ∈ T := by
  induction K with
  | zero => simpa using h1
  | succ K ih =>
    rw [pow_succ, Nat.mul_mod]
    have := hT _ ih
    rwa [Nat.mul_mod, Nat.mod_mod] at this

/-- The powers of `3` modulo `100`. -/
private def T3 : List ℕ :=
  [1, 3, 9, 27, 81, 43, 29, 87, 61, 83, 49, 47, 41, 23, 69, 7, 21, 63, 89, 67]

/-- The powers of `5` modulo `100`. -/
private def T5 : List ℕ := [1, 5, 25]

/-- Odd case: if all powers of `D` modulo `100` avoid the multiples of `11`, then `D ^ K ≥ 10`
is not a repdigit. -/
private lemma not_repdigit_odd (D K : ℕ) (T : List ℕ) (h1 : 1 ∈ T)
    (hT : ∀ t ∈ T, t * D % 100 ∈ T) (h11 : ∀ t ∈ T, t % 11 ≠ 0) (hK : 10 ≤ D ^ K) :
    ¬ IsRepdigit (D ^ K) := fun h =>
  h11 _ (pow_mod_mem D T h1 hT K) (repdigit_mod_hundred h hK)

/-- Even case: if `2 ∣ D` and `K ≥ 4` then `D ^ K` is not a repdigit. -/
private lemma not_repdigit_even (D K : ℕ) (hD : 2 ∣ D) (hD0 : 0 < D) (hK : 4 ≤ K) :
    ¬ IsRepdigit (D ^ K) := fun h => by
  apply repdigit_not_dvd_sixteen h (pow_pos hD0 K)
  have h16 : (16 : ℕ) = 2 ^ 4 := by norm_num
  rw [h16]
  exact (Nat.pow_dvd_pow 2 hK).trans (pow_dvd_pow_of_dvd hD K)

/-- For `2 ≤ D ≤ 9` and `K ≥ 4`, `D ^ K` is not a repdigit. -/
private lemma not_repdigit_pow (D K : ℕ) (hD2 : 2 ≤ D) (hD9 : D ≤ 9) (hK : 4 ≤ K) :
    ¬ IsRepdigit (D ^ K) := by
  have h10 : 10 ≤ D ^ K := by
    calc 10 ≤ 2 ^ 4 := by norm_num
      _ ≤ 2 ^ K := Nat.pow_le_pow_right (by norm_num) hK
      _ ≤ D ^ K := Nat.pow_le_pow_left hD2 K
  interval_cases D
  · exact not_repdigit_even 2 K (by norm_num) (by norm_num) hK
  · exact not_repdigit_odd 3 K T3 (by decide) (by decide) (by decide) h10
  · exact not_repdigit_even 4 K (by norm_num) (by norm_num) hK
  · exact not_repdigit_odd 5 K T5 (by decide) (by decide) (by decide) h10
  · exact not_repdigit_even 6 K (by norm_num) (by norm_num) hK
  · exact not_repdigit_odd 7 K T3 (by decide) (by decide) (by decide) h10
  · exact not_repdigit_even 8 K (by norm_num) (by norm_num) hK
  · exact not_repdigit_odd 9 K T3 (by decide) (by decide) (by decide) h10

/-- Every term `m ≥ 1111` is a repunit. -/
private lemma isRepunit_of_isTerm {m : ℕ} (hm : IsTerm m) (hge : 1111 ≤ m) : IsRepunit m := by
  obtain ⟨h1, h2⟩ := hm
  obtain ⟨k, d, hd, rfl⟩ := repdigit_eq h1 (by omega)
  have hdig := digits_rep (d := d + 1) (by omega) (by omega) (k + 1)
  have hk : 3 ≤ k := by
    by_contra hk
    have hlt := Nat.lt_base_pow_length_digits (b := 10) (m := rep (d + 1) (k + 1)) (by norm_num)
    rw [hdig, List.length_replicate] at hlt
    have : 10 ^ (k + 1) ≤ 10 ^ 3 := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  rcases Nat.eq_zero_or_pos d with rfl | hdpos
  · intro x hx
    rw [hdig] at hx
    exact List.eq_of_mem_replicate hx
  · exfalso
    have hprod : digitProd (rep (d + 1) (k + 1)) = (d + 1) ^ (k + 1) := by
      unfold digitProd
      rw [if_neg (by omega), hdig, List.prod_replicate]
    rw [hprod] at h2
    exact not_repdigit_pow (d + 1) (k + 1) (by omega) (by omega) (by omega) h2

/-- `a 16 = 1111`. -/
private lemma a_sixteen : a 16 = 1111 := by
  have := congrArg (fun l => l[15]?) a_data
  simpa using this

/-- Krizek's conjecture (A201060): `a(n)` is a repunit for every `n ≥ 16`. -/
theorem result : statement := by
  intro n hn
  have hterm : IsTerm (a n) := Nat.nth_mem_of_infinite infinite_isTerm (n - 1)
  have hge : 1111 ≤ a n := by
    rw [← a_sixteen]
    exact Nat.nth_monotone infinite_isTerm (by omega)
  exact isRepunit_of_isTerm hterm hge

end Math0.Frontier.A201060

#math0_settles Math0.Frontier.A201060.result Math0.Statements.A201060.statement
