      ([2, 1, 1], 54), ([], 107), ([1, 2, 1, 2, 1, 2], 94), ([1, 0, 2, 0], 88), ([1, 0], 95),
      ([1, 2, 0], 54)],
    [
      ([], 73), ([2], 73), ([0], 110), ([1, 1], 108), ([1, 1, 2], 108), ([], 110), ([0], 73),
      ([2], 73), ([1, 0], 108), ([1, 0, 2], 108), ([], 111), ([1, 0, 2, 1], 111), ([2], 110),
