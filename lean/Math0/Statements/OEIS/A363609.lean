/-- Every representative is a duplicate-free list of codes with coordinates in `[10, 22]`. -/
theorem reps_ok : ∀ n < 6, ((reps.getD n []).all fun C => decide C.Nodup && C.all goodT) = true := by
  decide +kernel

/-- The certificates are correct. -/
theorem certs_ok : ∀ n < 5, levelCert (reps.getD (n + 1) []) (reps.getD n []) (hints.getD n []) =
    true := by
  decide +kernel

theorem reps_spec {n : ℕ} (hn : n < 6) {C : List ℕ} (hC : C ∈ reps.getD n []) :
    C.Nodup ∧ ∀ k ∈ C, goodT k = true := by
  have h := List.all_eq_true.1 (reps_ok n hn) C hC
  simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  exact h

/-- One-cell extension of a polycube that has a representative. -/
theorem kid_step {C : List ℕ} (hC : ∀ k ∈ C, goodT k = true) {Q : Finset Cell}
    {h : Cell → Cell} (hh : Adm h) (hQ : Q.image h = D C) {x z : Cell} (hxQ : x ∉ Q)
    (hz : z ∈ Q) (hxz : x - z ∈ dirs) :
    ∃ j k, k ∈ C ∧ j ∈ nbrs k ∧ j ∉ C ∧ (insert x Q).image h = D (ins j C) := by
  have hzC : h z ∈ D C := hQ ▸ Finset.mem_image_of_mem h hz
  obtain ⟨k, hk, hkz⟩ := mem_D_iff.1 hzC
  have hd := hh.2.2 x z hxz
  obtain ⟨j, hj, hjx⟩ : ∃ j ∈ nbrs k, dec j = h x := by
    have h2 : dec k + (h x - h z) ∈ (nbrs k).map dec := by
      rw [dec_nbrs (good_of_near (near_of_goodT (hC k hk)))]
      exact List.mem_map_of_mem (mem_dirs.1 hd)
    rw [hkz, add_sub_cancel] at h2
    simpa only [List.mem_map] using h2
  have hjC : j ∉ C := by
    intro hjC
    have h3 : dec j ∈ D C := mem_D.2 hjC
    rw [← hQ, hjx, hh.1.mem_finset_image] at h3
    exact hxQ h3
  refine ⟨j, k, hk, hj, hjC, ?_⟩
  rw [Finset.image_insert, hQ, D_ins, hjx]

theorem ins_facts {C : List ℕ} (hC : C.Nodup ∧ ∀ k ∈ C, goodT k = true) {j k : ℕ} (hk : k ∈ C)
    (hj : j ∈ nbrs k) (hjC : j ∉ C) : (ins j C).Nodup ∧ ∀ m ∈ ins j C, Near m := by
  refine ⟨(ins_perm j C).nodup_iff.2 (List.nodup_cons.2 ⟨hjC, hC.1⟩), fun m hm => ?_⟩
  rcases mem_ins.1 hm with rfl | hm
  · exact near_of_mem_nbrs (hC.2 k hk) hj
  · exact near_of_goodT (hC.2 m hm)

/-- Every polycube with `n + 1 ≤ 6` cells is mapped onto a representative by an admissible
map. -/
theorem complete : ∀ n ≤ 5, ∀ P : Finset Cell, P.card = n + 1 → FaceConnected P →
    ∃ C ∈ reps.getD n [], ∃ h, Adm h ∧ P.image h = D C := by
  intro n
  induction n with
  | zero =>
    intro _ P hc _
    obtain ⟨x, rfl⟩ := Finset.card_eq_one.1 hc
    refine ⟨[16912], by decide +kernel, (· + ((16, 16, 16) - x)), adm_add _, ?_⟩
    rw [Finset.image_singleton, add_sub_cancel]
    decide +kernel
  | succ n ih =>
    intro hn P hc hP
    obtain ⟨x, Q, z, rfl, hxQ, hQ, hzQ, hxz⟩ := exists_leaf hP (by omega)
    rw [Finset.card_insert_of_notMem hxQ] at hc
    obtain ⟨C, hC, h, hh, hQC⟩ := ih (by omega) Q (by omega) hQ
    have hCs := reps_spec (by omega) hC
    obtain ⟨j, k, hk, hj, hjC, hP'⟩ := kid_step hCs.2 hh hQC hxQ hzQ hxz
    obtain ⟨X, hX, w, hw⟩ :=
      levelCert_spec (certs_ok n (by omega)) C hC (ins j C) (mem_kids hk hj hjC)
    obtain ⟨g, hg, hD⟩ := D_cert w (ins_ne_nil j C) (ins_facts hCs hk hj hjC).2
    exact ⟨X, hX, g ∘ h, hg.comp hh, by rw [← Finset.image_image, hP', ← hD, hw]⟩

/-! ### Lower bounds -/

/-- The terms `a(1), …, a(57)` listed in the entry (DATA). -/
def oeisData : List ℕ :=
  [21, 30, 40, 40, 51, 52, 54, 48, 60, 62, 65, 60, 72, 74, 77, 72, 78, 74, 86, 84, 91, 88, 92,
    88, 95, 93, 90, 102, 105, 102, 106, 104, 107, 110, 109, 106, 118, 120, 121, 120, 125, 123,
    126, 125, 122, 128, 127, 124, 136, 138, 139, 140, 141, 138, 145, 144, 143]

/-- The least value of `LB` over the representatives with `n + 1 ≤ 6` cells is the listed
term. -/
theorem minVal_ok : ∀ n < 6, minVal (reps.getD n []) = oeisData.getD n 0 := by decide +kernel

/-- All one-cell extensions of `C` have value at least `v`. -/
def kidsGe (v : ℕ) (C : List ℕ) : Bool := (kids C).all fun ch => Nat.ble v (valW ch)

theorem kids_ok_a : reps5a.all (kidsGe 54) = true := by decide +kernel

theorem kids_ok_b : reps5b.all (kidsGe 54) = true := by decide +kernel

theorem kids_ok_c : reps5c.all (kidsGe 54) = true := by decide +kernel

theorem kids_ok_d : reps5d.all (kidsGe 54) = true := by decide +kernel

theorem kids_ok {C : List ℕ} (hC : C ∈ reps.getD 5 []) : kidsGe 54 C = true := by
  have e : reps.getD 5 [] = reps5a ++ reps5b ++ reps5c ++ reps5d := rfl
  rw [e] at hC
  simp only [List.mem_append] at hC
  rcases hC with ((hC | hC) | hC) | hC
  · exact List.all_eq_true.1 kids_ok_a C hC
  · exact List.all_eq_true.1 kids_ok_b C hC
  · exact List.all_eq_true.1 kids_ok_c C hC
  · exact List.all_eq_true.1 kids_ok_d C hC

theorem LB_ge_minVal {n : ℕ} (hn : n ≤ 5) {P : Finset Cell} (hc : P.card = n + 1)
    (hP : FaceConnected P) : minVal (reps.getD n []) ≤ LB P := by
  obtain ⟨C, hC, h, hh, hPC⟩ := complete n hn P hc hP
  obtain ⟨hnd, hg⟩ := reps_spec (by omega) hC
  calc minVal (reps.getD n []) ≤ valW C := minVal_le hC
    _ = LB (D C) := valW_eq hnd fun k hk => good_of_near (near_of_goodT (hg k hk))
    _ = LB P := by rw [← hPC, hh.2.1]

theorem LB_ge_seven {P : Finset Cell} (hc : P.card = 7) (hP : FaceConnected P) : 54 ≤ LB P := by
  obtain ⟨x, Q, z, rfl, hxQ, hQ, hzQ, hxz⟩ := exists_leaf hP (by omega)
  rw [Finset.card_insert_of_notMem hxQ] at hc
  obtain ⟨C, hC, h, hh, hQC⟩ := complete 5 le_rfl Q (by omega) hQ
  have hCs := reps_spec (by omega) hC
  obtain ⟨j, k, hk, hj, hjC, hP'⟩ := kid_step hCs.2 hh hQC hxQ hzQ hxz
  obtain ⟨hnd, hnear⟩ := ins_facts hCs hk hj hjC
  have hv := List.all_eq_true.1 (kids_ok hC) _ (mem_kids hk hj hjC)
  calc 54 ≤ valW (ins j C) := Nat.le_of_ble_eq_true hv
    _ = LB (D (ins j C)) := valW_eq hnd fun m hm => good_of_near (hnear m hm)
    _ = LB (insert x Q) := by rw [← hP', hh.2.1]

/-! ## The data -/

theorem wits_data : wits.map (fun e => (e.1, e.2.1)) =
    (List.range 57).map (fun i => (i + 1, oeisData.getD i 0)) := by decide +kernel

theorem mem_totals_data : ∀ i < 57, oeisData.getD i 0 ∈ totals (i + 1) := by
  intro i hi
  have hmem : (i + 1, oeisData.getD i 0) ∈ wits.map (fun e => (e.1, e.2.1)) := by
    rw [wits_data]
    exact List.mem_map.2 ⟨i, List.mem_range.2 hi, rfl⟩
  obtain ⟨e, he, hee⟩ := List.mem_map.1 hmem
  have := mem_totals_of_witOK (List.all_eq_true.1 wits_ok e he)
  simp only [Prod.mk.injEq] at hee
  rwa [hee.1, hee.2] at this

/-- Upper bounds: `a n` is at most the listed value, for all `57` listed terms (kernel-checked
witnesses). -/
theorem a_le_data : ∀ i < 57, a (i + 1) ≤ oeisData.getD i 0 :=
  fun i hi => Nat.sInf_le (mem_totals_data i hi)

theorem a_eq_of {n v : ℕ} (hv : v ∈ totals n)
    (hlb : ∀ P : Finset Cell, P.card = n → FaceConnected P → v ≤ LB P) : a n = v :=
  IsLeast.csInf_eq ⟨hv, fun _ ht => by
    obtain ⟨P, hc, hP, hle⟩ := exists_LB_le ht
    exact (hlb P hc hP).trans hle⟩

theorem a_eq_data {i : ℕ} (hi : i ≤ 5) : a (i + 1) = oeisData.getD i 0 :=
  a_eq_of (mem_totals_data i (by omega)) fun _ hc hP =>
    (minVal_ok i (by omega)).symm ▸ LB_ge_minVal hi hc hP

/-- The definition reproduces the first seven listed terms exactly (kernel-checked enumeration of
all polycubes with at most `7` cells, up to symmetry). -/
theorem a_data : (List.range 7).map (fun i => a (i + 1)) = [21, 30, 40, 40, 51, 52, 54] := by
  have e7 : a 7 = 54 := a_eq_of (mem_totals_data 6 (by norm_num)) fun _ hc hP => LB_ge_seven hc hP
  show [a 1, a 2, a 3, a 4, a 5, a 6, a 7] = [21, 30, 40, 40, 51, 52, 54]
  rw [a_eq_data (i := 0) (by norm_num), a_eq_data (i := 1) (by norm_num),
    a_eq_data (i := 2) (by norm_num), a_eq_data (i := 3) (by norm_num),
    a_eq_data (i := 4) (by norm_num), a_eq_data (i := 5) (by norm_num), e7]
  rfl

/-! ## The conjecture -/

/-- The conjecture of A363609: `a(k^3) = 6 (k + 2) k` for every `k > 1`. (The `k × k × k` cube
with the dice turned so that `1, 2, 3` are visible at the `8` corners, `1, 2` on the `12 (k - 2)`
edge dice and `1` on the `6 (k - 2)²` face dice shows `48 + 36 (k - 2) + 6 (k - 2)² = 6 k (k + 2)`
pips, so `a (k ^ 3) ≤ 6 k (k + 2)`; the conjecture is the matching lower bound.) -/
def statement : Prop := ∀ k : ℕ, 1 < k → a (k ^ 3) = 6 * (k + 2) * k

end Math0.Statements.A363609
