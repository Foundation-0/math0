/-- The sublist of `dirsL` selected by six booleans. -/
def sel (b0 b1 b2 b3 b4 b5 : Bool) : List Cell :=
  dirsL.filter fun d => (d == (1, 0, 0) && b0) || (d == (-1, 0, 0) && b1) ||
    (d == (0, 1, 0) && b2) || (d == (0, -1, 0) && b3) || (d == (0, 0, 1) && b4) ||
    (d == (0, 0, -1) && b5)

theorem fmin_sel : ∀ b0 b1 b2 b3 b4 b5 : Bool,
    fmin (sel b0 b1 b2 b3 b4 b5) = tabF b0 b1 b2 b3 b4 b5 := by decide +kernel

theorem filter_dirsL (p : Cell → Bool) :
    dirsL.filter p = sel (p (1, 0, 0)) (p (-1, 0, 0)) (p (0, 1, 0)) (p (0, -1, 0)) (p (0, 0, 1))
      (p (0, 0, -1)) := by
  simp only [sel, dirsL, List.filter_cons, List.filter_nil]
  cases p (1, 0, 0) <;> cases p (-1, 0, 0) <;> cases p (0, 1, 0) <;> cases p (0, -1, 0) <;>
    cases p (0, 0, 1) <;> cases p (0, 0, -1) <;> decide +kernel

/-- A bitmask of the codes in `L`. -/
def maskOf (L : List ℕ) : ℕ := L.foldr (fun k m => m ||| 2 ^ k) 0

theorem testBit_maskOf (L : List ℕ) (j : ℕ) : (maskOf L).testBit j = decide (j ∈ L) := by
  induction L with
  | nil => simp [maskOf]
  | cons k L ih =>
    simp only [maskOf, List.foldr_cons] at ih ⊢
    rw [Nat.testBit_or, ih, Nat.testBit_two_pow]
    by_cases h : j = k
    · subst h; simp
    · simp [h, Ne.symm h]

/-- The least number of visible pips of the die with code `k`, in the polycube with bitmask
`M`. -/
def cellVal (M k : ℕ) : ℕ :=
  tabF (!M.testBit (k + 1)) (!M.testBit (k - 1)) (!M.testBit (k + 32)) (!M.testBit (k - 32))
    (!M.testBit (k + 1024)) (!M.testBit (k - 1024))

/-- `LB` of the polycube encoded by `L`, computed on codes. -/
def valW (L : List ℕ) : ℕ := (L.map (cellVal (maskOf L))).sum

theorem cellVal_eq {L : List ℕ} {k : ℕ} (hk : good k = true) :
    cellVal (maskOf L) k = fmin (exposed (D L) (dec k)) := by
  have h := dec_nbrs hk
  simp only [nbrs, dirsL, List.map_cons, List.map_nil, List.cons.injEq, and_true] at h
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := h
  rw [exposed, filter_dirsL, fmin_sel, cellVal]
  simp only [testBit_maskOf, ← h1, ← h2, ← h3, ← h4, ← h5, ← h6, mem_D, decide_not]

theorem valW_eq {L : List ℕ} (hn : L.Nodup) (hg : ∀ k ∈ L, good k = true) :
    valW L = LB (D L) := by
  rw [LB, D, List.sum_toFinset _ (hn.map dec_inj), List.map_map, valW]
  congr 1
  refine List.map_congr_left fun k hk => ?_
  rw [Function.comp_apply, cellVal_eq (hg k hk)]
  rfl

/-! ### Upper bounds from witnesses -/

/-- Whether two codes are face-adjacent. -/
def isNbr (j k : ℕ) : Bool :=
  j == k + 1 || k == j + 1 || j == k + 32 || k == j + 32 || j == k + 1024 || k == j + 1024

/-- A growth certificate on codes: every code is adjacent to a later one. -/
def growsC : List ℕ → Bool
  | [] => true
  | [_] => true
  | x :: y :: l => (y :: l).any (isNbr x) && growsC (y :: l)

/-- The list is strictly decreasing. -/
def sdesc : List ℕ → Bool
  | [] => true
  | [_] => true
  | x :: y :: l => Nat.blt y x && sdesc (y :: l)

theorem sdesc_lt : ∀ {x : ℕ} {l : List ℕ}, sdesc (x :: l) = true → ∀ z ∈ l, z < x
  | _, [], _, z, hz => absurd hz List.not_mem_nil
  | x, y :: l, h, z, hz => by
    simp only [sdesc, Bool.and_eq_true, Nat.blt_eq] at h
    rcases List.mem_cons.1 hz with rfl | hz
    · exact h.1
    · exact (sdesc_lt h.2 z hz).trans h.1

theorem sdesc_nodup : ∀ {l : List ℕ}, sdesc l = true → l.Nodup
  | [], _ => List.nodup_nil
  | [x], _ => List.nodup_singleton x
  | x :: y :: l, h => by
    refine List.nodup_cons.2 ⟨fun hx => lt_irrefl x (sdesc_lt h x hx), sdesc_nodup ?_⟩
    simp only [sdesc, Bool.and_eq_true] at h
    exact h.2

theorem dec_sub_mem_dirs {j k : ℕ} (hj : good j = true) (hk : good k = true)
    (h : isNbr j k = true) : dec j - dec k ∈ dirs := by
  have hj' := dec_nbrs hj
  have hk' := dec_nbrs hk
  simp only [nbrs, dirsL, List.map_cons, List.map_nil, List.cons.injEq, and_true] at hj' hk'
  simp only [isNbr, Bool.or_eq_true, beq_iff_eq] at h
  rcases h with ((((h | h) | h) | h) | h) | h <;> subst h
  · rw [hk'.1, add_sub_cancel_left]; decide +kernel
  · rw [hj'.1, sub_add_cancel_left]; decide +kernel
  · rw [hk'.2.2.1, add_sub_cancel_left]; decide +kernel
  · rw [hj'.2.2.1, sub_add_cancel_left]; decide +kernel
  · rw [hk'.2.2.2.2.1, add_sub_cancel_left]; decide +kernel
  · rw [hj'.2.2.2.2.1, sub_add_cancel_left]; decide +kernel

theorem growsB_of_growsC : ∀ {L : List ℕ}, growsC L = true → (∀ k ∈ L, good k = true) →
    growsB (L.map dec) = true
  | [], _, _ => rfl
  | [_], _, _ => rfl
  | x :: y :: l, h, hg => by
    simp only [growsC, Bool.and_eq_true, List.any_eq_true] at h
    obtain ⟨⟨z, hz, hxz⟩, h⟩ := h
    simp only [List.map_cons, growsB, Bool.and_eq_true, List.any_eq_true, decide_eq_true_eq]
    refine ⟨⟨dec z, ?_, dec_sub_mem_dirs (hg x List.mem_cons_self) (hg z
      (List.mem_cons_of_mem _ hz)) hxz⟩, ?_⟩
    · rw [← List.map_cons]; exact List.mem_map_of_mem hz
    · rw [← List.map_cons]
      exact growsB_of_growsC h fun k hk => hg k (List.mem_cons_of_mem _ hk)

/-- A witness `(n, v, L)`: `L` encodes a polycube with `n` cells whose least number of visible
pips is `v`. -/
def witOK (e : ℕ × ℕ × List ℕ) : Bool :=
  e.2.2.length == e.1 && sdesc e.2.2 && e.2.2.all good && growsC e.2.2 && valW e.2.2 == e.2.1

theorem mem_totals_of_witOK {e : ℕ × ℕ × List ℕ} (h : witOK e = true) : e.2.1 ∈ totals e.1 := by
  obtain ⟨n, v, L⟩ := e
  simp only [witOK, Bool.and_eq_true, beq_iff_eq, List.all_eq_true] at h
  obtain ⟨⟨⟨⟨hl, hs⟩, hg⟩, hgr⟩, hv⟩ := h
  have hn := sdesc_nodup hs
  have hmem : LB (D L) ∈ totals n := by
    refine LB_mem_totals ?_ ?_
    · rw [D, List.toFinset_card_of_nodup (hn.map dec_inj), List.length_map, hl]
    · exact faceConnected_of_growsB _ (growsB_of_growsC hgr hg)
  rwa [← valW_eq hn hg, hv] at hmem

